generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int            @id @default(autoincrement())
  loginId   String         @unique
  name      String
  password  String
  createdAt DateTime       @default(now())
  reviews   DesignReview[]
}

model DesignReview {
  id        Int      @id @default(autoincrement())
  url       String
  score     Int
  result    String
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
